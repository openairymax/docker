# =============================================================================
# AgentRT OpenLab Dockerfile
# 版本: 0.1.1 (Production-Ready)
# 最后更新: 2026-05-05
#
# 设计原则:
# 1. 多阶段构建：Python后端 + Nginx前端分离
# 2. 安全默认配置：非root用户、最小依赖、cap_drop
# 3. 生产优化：Nginx反向代理 + Gzip压缩 + 安全头
#
# ⚠️ 构建上下文: 伞仓根 (context: ../..)
#    源码路径: ecosystem/openlab/
# =============================================================================

# =============================================================================
# 阶段1: 后端构建 (Backend Builder)
# =============================================================================
FROM python:3.12-slim AS backend-builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential=12.10ubuntu1 \
    libpq-dev=16.14-0ubuntu0.24.04.1 \
    && rm -rf /var/lib/apt/lists/*

COPY ecosystem/openlab/openlab/requirements.txt ./requirements.txt

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt \
    && apt-get purge -y build-essential libpq-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 阶段2: 运行时环境 (Runtime - Production)
# =============================================================================
FROM python:3.12-slim AS production

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL maintainer="SPHARX DevOps <devops@spharx.cn>" \
      org.opencontainers.image.title="AgentRT OpenLab" \
      org.opencontainers.image.description="AgentRT智能体交互平台 (生产级)" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.source="https://gitcode.com/spharx/agentrt" \
      org.opencontainers.image.vendor="SPHARX Ltd." \
      org.opencontainers.image.licenses="Proprietary"

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx=1.24.0-2ubuntu7.15 \
    curl=8.5.0-2ubuntu10.11 \
    ca-certificates=20260601~24.04.1 \
    libpq5=16.14-0ubuntu0.24.04.1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && userdel -r ubuntu 2>/dev/null || true \
    && groupadd -r -g 1000 openlab \
    && useradd -l -r -u 1000 -g openlab -d /app -s /sbin/nologin openlab \
    && mkdir -p /app/{backend,config,data,logs,run,tmp} \
    && chown -R openlab:openlab /app

COPY --from=backend-builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY ecosystem/openlab/ ./app_src/
RUN if [ -d ./app_src/openlab ]; then \
        cp -r ./app_src/openlab/* /app/backend/ && rm -rf ./app_src; \
    else \
        cp -r ./app_src/* /app/backend/ && rm -rf ./app_src; \
    fi

COPY products/docker/config/nginx/openlab.conf /etc/nginx/sites-available/default
COPY products/docker/scripts/openlab-entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log \
    && chown -R openlab:openlab /app /etc/nginx/sites-available/default \
    && find /app -type d -exec chmod 750 {} \; \
    && find /app -type f -exec chmod 640 {} \;

USER openlab

WORKDIR /app

EXPOSE 443/tcp 8000/tcp

ENV OPENLAB_HOME=/app \
    OPENLAB_CONFIG_DIR=/app/config \
    OPENLAB_DATA_DIR=/app/data \
    OPENLAB_LOG_DIR=/app/logs \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Shanghai

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8000/health > /dev/null 2>&1 || exit 1

CMD ["/app/entrypoint.sh"]

# =============================================================================
# 阶段3: 开发环境 (Development)
# =============================================================================
FROM production AS development

LABEL stage="development"

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb=15.1-1ubuntu1~24.04.1 \
    strace=6.8-0ubuntu2 \
    vim-tiny=2:9.1.0016-1ubuntu7.18 \
    htop=3.3.0-4build1 \
    net-tools=2.10-0.1ubuntu4.4 \
    iputils-ping=3:20240117-1ubuntu0.1 \
    && rm -rf /var/lib/apt/lists/*

USER openlab

ENV LOG_LEVEL=DEBUG
ENV OPENLAB_DEBUG=true

EXPOSE 5173/tcp 8000/tcp
