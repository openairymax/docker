# =============================================================================
# AgentRT Daemon Dockerfile - 生产级构建
# 版本: 0.1.1 (Production-Ready)
# 最后更新: 2026-04-15
#
# 🎯 生产级特性:
# ✅ 多目标构建 (Builder → Runtime → Gateway → Debug)
# ✅ 进程管理 (Supervisor + 健康检查)
# ✅ 安全加固 (非root、最小权限、只读文件系统)
# ✅ 端口最小化 (仅暴露必要端口)
# ✅ 日志标准化 (JSON 格式 + 轮转)
# =============================================================================

# =============================================================================
# 阶段1: 构建环境 (Builder)
# =============================================================================
FROM ubuntu:24.04 AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG DAEMON_SERVICES=all

# 安装构建依赖（固定版本，对齐 ubuntu 24.04 noble 仓库实际版本）
RUN apt-get update && apt-get install -y --no-install-recommends \
    # C/C++ 编译工具
    build-essential=12.10ubuntu1 \
    cmake=3.28.3-1build7 \
    ninja-build=1.11.1-2 \
    gcc-12=12.4.0-2ubuntu1~24.04.1 \
    g++-12=12.4.0-2ubuntu1~24.04.1 \
    # Python 构建工具链
    python3=3.12.3-0ubuntu2.1 \
    python3-dev=3.12.3-0ubuntu2.1 \
    python3-pip=24.0+dfsg-1ubuntu1.3 \
    python3-venv=3.12.3-0ubuntu2.1 \
    # SSL/TLS
    libssl-dev=3.0.13-0ubuntu3.12 \
    # 数据格式库
    libyaml-dev=0.2.5-1build1 \
    libcjson-dev=1.7.17-1 \
    libcurl4-openssl-dev=8.5.0-2ubuntu10.11 \
    libsqlite3-dev=3.45.1-1ubuntu2.7 \
    libmicrohttpd-dev=1.0.0-2.1ubuntu2 \
    libwebsockets-dev=4.3.3-1.1build3 \
    libpq-dev=16.14-0ubuntu0.24.04.1 \
    # UUID 生成（uuid/uuid.h）
    uuid-dev=2.39.3-9ubuntu6.5 \
    # 包管理
    pkg-config=1.8.1-2build1 \
    git=1:2.43.0-1ubuntu7.3 \
    curl=8.5.0-2ubuntu10.11 \
    ca-certificates=20260601~24.04.1 \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /build

# 复制守护进程源码、Python SDK 与伞仓 cmake 模块（context 为伞仓根 airymaxhub/）
COPY agentrt/ ./agentrt/
COPY sdk/ ./sdk/
COPY cmake/ ./cmake/

# 创建 Python 虚拟环境并安装依赖
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 安装 Python SDK（使用系统 pip 24.0；pip 23.x 与 Python 3.12 不兼容）
RUN pip install --no-cache-dir -e sdk/sdk-python
RUN pip cache purge 2>/dev/null || true

# 编译 C/C++ 组件并安装（BAN-33：构建目录必须在源码树外）。
# 生产镜像禁用 sanitizer/测试：缩小体积、避免 ASan 运行时开销。
# 注意：清理步骤单独 RUN，避免 `|| true` 破坏 && 链导致 cmake 失败被静默吞掉。
RUN cmake -S ./agentrt -B /build/out -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DENABLE_SANITIZERS=OFF \
    -DBUILD_TESTS=OFF \
    && cmake --build /build/out --parallel "$(nproc)" \
    && cmake --install /build/out
RUN find /opt/venv -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && pip cache purge 2>/dev/null || true \
    && rm -rf /root/.cache/pip /tmp/* /var/tmp/* \
    && mkdir -p /usr/local/bin /usr/local/lib

# =============================================================================
# 阶段2: 运行时环境 (Runtime) - 守护进程服务
# =============================================================================
FROM ubuntu:24.04 AS runtime

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL maintainer="SPHARX DevOps <devops@spharx.cn>" \
      org.opencontainers.image.title="AgentRT Daemon Services v0.1.1" \
      org.opencontainers.image.description="AgentRT守护进程服务层 (生产级)" \
      org.opencontainers.image.version="0.1.1" \
      org.opencontainers.image.source="https://gitcode.com/spharx/agentrt" \
      org.opencontainers.image.vendor="SPHARX Ltd."

ARG DEBIAN_FRONTEND=noninteractive

# 安装最小运行时依赖（t64 包名对齐 ubuntu 24.04）
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 进程管理器
    supervisor=4.2.5-1ubuntu0.1 \
    # HTTP 客户端
    curl=8.5.0-2ubuntu10.11 \
    # TLS 证书
    ca-certificates=20260601~24.04.1 \
    # 运行时库（Ubuntu 24.04 t64 迁移后包名带 t64 后缀）
    libssl3t64=3.0.13-0ubuntu3.12 \
    libyaml-0-2=0.2.5-1build1 \
    libcjson1=1.7.17-1 \
    libcurl4t64=8.5.0-2ubuntu10.11 \
    libsqlite3-0=3.45.1-1ubuntu2.7 \
    libmicrohttpd12t64=1.0.0-2.1ubuntu2 \
    libwebsockets19t64=4.3.3-1.1build3 \
    libpq5=16.14-0ubuntu0.24.04.1 \
    procps=2:4.0.4-4ubuntu3.2 \
    tzdata=2026c-0ubuntu0.24.04.1 \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && apt-get clean \
    && apt-get autoremove -y \
    && userdel -r ubuntu 2>/dev/null || true \
    && groupadd -r -g 1000 agentrt \
    && useradd -l -r -u 1000 -g agentrt -d /app -s /sbin/nologin agentrt \
    && mkdir -p /app/{bin,config,data,logs,run,supervisor/conf.d,tmp} \
    && chown -R agentrt:agentrt /app \
    && chmod 750 /app \
    && chmod 700 /app/config /app/data /app/logs /app/run

# 复制虚拟环境和构建产物
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=builder /usr/local/bin/ /app/bin/
COPY --from=builder /usr/local/lib/ /app/lib/

# 复制 Supervisor 配置并设置权限（context 为伞仓根 airymaxhub/）
COPY products/docker/config/supervisor/supervisord.conf /etc/supervisor/supervisord.conf
RUN mkdir -p /app/bin /app/lib /app/supervisor/conf.d \
    && chown -R agentrt:agentrt /app/bin /app/lib /app/supervisor /etc/supervisor \
    && find /app/bin -type f -exec chmod 550 {} \; \
    && chmod 640 /etc/supervisor/supervisord.conf

USER agentrt
WORKDIR /app

# 暴露最小必要端口（通过 Gateway 统一暴露；gateway_d 源码默认 HTTP 8080 / WebSocket 8081）
EXPOSE 8080/tcp 8081/tcp

# AIRY_HOME 为 daemon 源码（commons/platform/platform.c）实际读取的根目录环境变量，
# AGENTRT_HOME 保留为容器内部约定（supervisord 两侧均注入，保证路径体系一致）
ENV AGENTRT_HOME=/app \
    AIRY_HOME=/app \
    AGENTRT_CONFIG_DIR=/app/config \
    AGENTRT_DATA_DIR=/app/data \
    AGENTRT_LOG_DIR=/app/logs \
    AGENTRT_RUN_DIR=/app/run \
    LOG_LEVEL=INFO \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

# 健康检查：探测 gateway 8080 的 JSON-RPC 端点（gateway 转发 info.system），
# 失败时兜底检测 Supervisor 主进程存活
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS -X POST http://localhost:8080/api/ -H 'Content-Type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"info.system","params":{}}' > /dev/null 2>&1 || pgrep -x supervisord > /dev/null || exit 1

CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf"]

# =============================================================================
# 阶段3: Gateway 服务 (Gateway) - HTTP/WS/stdio 三协议网关
# =============================================================================
FROM runtime AS gateway

# 复制 Gateway 配置
COPY products/docker/config/gateway.yaml /app/config/gateway.yaml

# 额外暴露 Gateway 端口（gateway_d 源码默认 HTTP 8080 / WebSocket 8081）
EXPOSE 8080/tcp 8081/tcp

ENV GATEWAY_ENABLED=true \
    GATEWAY_PORT=8080 \
    GATEWAY_ADMIN_PORT=8081

# 覆盖启动命令，启动 Gateway + Supervisor
CMD ["bash", "-c", "supervisord -c /etc/supervisor/supervisord.conf"]

# =============================================================================
# 阶段4: 调试版本 (Debug)
# =============================================================================
FROM runtime AS debug

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb=15.1-1ubuntu1~24.04.1 \
    strace=6.8-0ubuntu2 \
    htop=3.3.0-4build1 \
    net-tools=2.10-0.1ubuntu4.4 \
    vim-tiny=2:9.1.0016-1ubuntu7.18 \
    && rm -rf /var/lib/apt/lists/*

USER agentrt
ENV LOG_LEVEL=DEBUG
