# =============================================================================
# AgentOS 环境变量配置模板 (Development)
# 版本: 3.0.0 (Enterprise-Grade)
# 最后更新: 2026-04-23
#
# 使用方法:
#   cp .env.example .env
#   vim .env
#
# 注意:
#   - 所有密码都应修改为强密码
#   - API 密钥需要填写真实的密钥值
# =============================================================================

# -----------------------------------------------------------------------------
# 通用配置 (General)
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
TZ=Asia/Shanghai
LANG=C.UTF-8
LC_ALL=C.UTF-8

# AgentOS 版本号
AGENTOS_VERSION=3.0.0

# -----------------------------------------------------------------------------
# Gateway 服务配置 (Gateway)
# -----------------------------------------------------------------------------
GATEWAY_PORT=18789
GATEWAY_ADMIN_PORT=18790

# JWT 密钥 (开发环境可用默认值，生产环境必须修改)
GATEWAY_JWT_SECRET=dev_jwt_secret_2024_change_in_production_2026

# Token 配置
TOKEN_EXPIRY_HOURS=4
REFRESH_TOKEN_DAYS=2

# 速率限制 (开发环境较宽松)
GATEWAY_GLOBAL_QPS=5000
GATEWAY_PER_IP_QPS=100

# -----------------------------------------------------------------------------
# 内核服务配置 (Kernel)
# -----------------------------------------------------------------------------
KERNEL_IPC_PORT=18080
KERNEL_METRICS_PORT=9090

# 资源限制
CPU_LIMIT=4
CPU_RESERVATION=0.5
MEMORY_LIMIT=4G
MEMORY_RESERVATION=512M

MAX_CONNECTIONS=5000
MEMORY_LIMIT_MB=4096
CPU_CORES=4

# HeapStore 配置
HEAPSTORE_MAX_LOG_SIZE_MB=100
HEAPSTORE_LOG_RETENTION_DAYS=7
HEAPSTORE_CIRCUIT_THRESHOLD=5
HEAPSTORE_CIRCUIT_TIMEOUT_SEC=30

# -----------------------------------------------------------------------------
# PostgreSQL 数据库配置 (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=dev_password_2024_change_in_production

# PostgreSQL 性能调优
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_SLOW_QUERY_MS=1000

# -----------------------------------------------------------------------------
# Redis 缓存配置 (Redis)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=dev_redis_2024_change_in_production
REDIS_MAX_MEMORY=256mb

# -----------------------------------------------------------------------------
# LLM 服务配置 (LLM)
# -----------------------------------------------------------------------------
LLM_DEFAULT_MODEL=gpt-4
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Grafana 监控配置 (Grafana)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_2024

# -----------------------------------------------------------------------------
# 项目配置 (Project)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=agentos
