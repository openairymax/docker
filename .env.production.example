# =============================================================================
# AgentOS 生产环境变量配置模板 (Production)
# 版本: 3.0.0 (Enterprise-Grade)
# 最后更新: 2026-04-23
#
# 使用方法:
#   cp .env.production.example .env.production
#   vim .env.production
#
# ⚠️ 安全要求:
#   - 所有密码必须使用强随机值
#   - API 密钥必须填写真实的生产密钥
#   - JWT 密钥至少 64 字节
#   - 建议使用密钥管理服务 (Vault/AWS Secrets Manager)
# =============================================================================

# -----------------------------------------------------------------------------
# 通用配置 (General)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
TZ=Asia/Shanghai
LANG=C.UTF-8
LC_ALL=C.UTF-8

# AgentOS 版本号
AGENTOS_VERSION=3.0.0

# 域名配置
DOMAIN=api.yourcompany.com
SSL_CERT_PATH=/etc/ssl/certs/your-cert.pem
SSL_KEY_PATH=/etc/ssl/private/your-key.pem

# -----------------------------------------------------------------------------
# Gateway 服务配置 (Gateway)
# -----------------------------------------------------------------------------
GATEWAY_PORT=18789
GATEWAY_ADMIN_PORT=18790

# JWT 密钥 (必须修改为 64 字节强密钥)
# 生成: openssl rand -base64 64
GATEWAY_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# Token 配置
TOKEN_EXPIRY_HOURS=4
REFRESH_TOKEN_DAYS=2

# 速率限制 (生产环境)
GATEWAY_GLOBAL_QPS=10000
GATEWAY_PER_IP_QPS=200

# -----------------------------------------------------------------------------
# 内核服务配置 (Kernel)
# -----------------------------------------------------------------------------
KERNEL_IPC_PORT=18080
KERNEL_METRICS_PORT=9090

# 资源限制
CPU_LIMIT=4
CPU_RESERVATION=1
MEMORY_LIMIT=8G
MEMORY_RESERVATION=2G

MAX_CONNECTIONS=10000
MEMORY_LIMIT_MB=8192
CPU_CORES=4

# HeapStore 配置
HEAPSTORE_MAX_LOG_SIZE_MB=200
HEAPSTORE_LOG_RETENTION_DAYS=14
HEAPSTORE_CIRCUIT_THRESHOLD=5
HEAPSTORE_CIRCUIT_TIMEOUT_SEC=30

# -----------------------------------------------------------------------------
# PostgreSQL 数据库配置 (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# PostgreSQL 性能调优
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_SLOW_QUERY_MS=500

# -----------------------------------------------------------------------------
# Redis 缓存配置 (Redis)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
REDIS_MAX_MEMORY=2gb

# -----------------------------------------------------------------------------
# LLM 服务配置 (LLM)
# -----------------------------------------------------------------------------
LLM_DEFAULT_MODEL=gpt-4

# ⚠️ 必须填写真实的 API 密钥
OPENAI_API_KEY=sk-prod-YOUR_OPENAI_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-prod-YOUR_ANTHROPIC_KEY_HERE
DEEPSEEK_API_KEY=sk-prod-YOUR_DEEPSEEK_KEY_HERE
GOOGLE_API_KEY=AIza-prod-YOUR_GOOGLE_KEY_HERE

# -----------------------------------------------------------------------------
# Grafana 监控配置 (Grafana)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

# -----------------------------------------------------------------------------
# 告警通知配置 (AlertManager)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.yourcompany.com:25
SMTP_FROM=alertmanager@agentos.cn
SMTP_USER=
SMTP_PASS=

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

PAGERDUTY_SERVICE_KEY=

# -----------------------------------------------------------------------------
# 项目配置 (Project)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=agentos-prod
ENVIRONMENT=production
