# =============================================================================
# AgentOS Docker .dockerignore
# 排除不需要进入构建上下文的文件，减小镜像体积
# =============================================================================

# Git
.git
.gitignore
.github

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 文档
DocsClosed/
docs/
*.md
!README.md
LICENSE

# 测试
tests/
__pycache__/
*.pyc
.pytest_cache/
coverage/
.coverage
htmlcov/

# 构建产物
dist/
build/
*.egg-info/
node_modules/

# 依赖锁文件（在Dockerfile中处理）
package-lock.json
yarn.lock
pnpm-lock.yaml
requirements.txt
Pipfile.lock
poetry.lock

# 环境变量（安全）
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example

# 日志和数据
logs/
data/
*.log
*.db
*.sqlite3

# 临时文件
tmp/
temp/
.tmp/
.temp/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker（避免递归）
Docker/docker-compose*.yml
Docker/.env*

# Desktop开发配置（保留生产所需）
Desktop/src-tauri/target/
Desktop/node_modules/
Desktop/dist/

# Python虚拟环境
venv/
.venv/
env/

# CMake构建缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# 调试符号
*.dSYM/
*.debug
