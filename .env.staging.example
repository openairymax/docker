# =============================================================================
# AgentOS Staging 环境变量配置模板
# 版本: 0.0.5 (Staging Environment — BAN-43 零明文密钥)
# 最后更新: 2026-05-06 (团队E 第09轮次)
#
# 使用方法:
#   cp .env.staging.example .env.staging
#   运行 ./scripts/quick-start.sh --generate-passwords
#   或手动: 将所有 __GENERATE__ 替换为 openssl rand 生成的密码
#
# 安全策略:
#   - 所有 __GENERATE__ 占位符必须替换为 openssl rand -hex 生成的随机密码
#   - quick-start.sh 启动时自动检测 __GENERATE__ 并生成强随机密码
#   - 禁止人工选择密码（BAN-43 合规）
# =============================================================================

# -----------------------------------------------------------------------------
# 通用配置 (General)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
TZ=Asia/Shanghai
LANG=C.UTF-8
LC_ALL=C.UTF-8

AGENTOS_VERSION=3.0.0

LOG_MAX_SIZE=50m
LOG_MAX_FILE=3

# -----------------------------------------------------------------------------
# Gateway 服务配置 (Gateway)
# -----------------------------------------------------------------------------
GATEWAY_PORT=18789
GATEWAY_ADMIN_PORT=18790

GATEWAY_JWT_SECRET=__GENERATE__

TOKEN_EXPIRY_HOURS=4
REFRESH_TOKEN_DAYS=2

GATEWAY_GLOBAL_QPS=10000
GATEWAY_PER_IP_QPS=200

# -----------------------------------------------------------------------------
# 内核服务配置 (Kernel)
# -----------------------------------------------------------------------------
KERNEL_IPC_PORT=18080
KERNEL_METRICS_PORT=9090

CPU_LIMIT=2
CPU_RESERVATION=0.5
MEMORY_LIMIT=2G
MEMORY_RESERVATION=512M

MAX_CONNECTIONS=5000
MEMORY_LIMIT_MB=4096
CPU_CORES=4

HEAPSTORE_MAX_LOG_SIZE_MB=200
HEAPSTORE_LOG_RETENTION_DAYS=14
HEAPSTORE_CIRCUIT_THRESHOLD=5
HEAPSTORE_CIRCUIT_TIMEOUT_SEC=30

# -----------------------------------------------------------------------------
# PostgreSQL 数据库配置 (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=agentos_staging
POSTGRES_USER=agentos
POSTGRES_PASSWORD=__GENERATE__

PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_SLOW_QUERY_MS=500

# -----------------------------------------------------------------------------
# Redis 缓存配置 (Redis)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__
REDIS_MAX_MEMORY=256mb

# -----------------------------------------------------------------------------
# Grafana 监控配置 (Grafana)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=__GENERATE_USERNAME__
GRAFANA_ADMIN_PASSWORD=__GENERATE__
GRAFANA_ANONYMOUS=false

# -----------------------------------------------------------------------------
# Desktop前端配置
# -----------------------------------------------------------------------------
DESKTOP_ORIGIN=http://localhost:5173
DESKTOP_ORIGIN_ALT=http://127.0.0.1:5173
CORS_DOMAIN=*.agentos.cn
WHITELIST_IPS=127.0.0.1
OPENLAB_BACKEND_HOST=openlab-backend
OPENLAB_BACKEND_PORT=8000

COMPOSE_PROJECT_NAME=agentos-staging
