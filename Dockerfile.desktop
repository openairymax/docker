# ===========================================================================
# AgentOS Desktop Frontend - Multi-stage Dockerfile
# 版本: 0.1.0 (团队D - 第09轮次)
# 用途: 构建Desktop Web前端的生产镜像（纯Vite构建，不含Tauri）
# ===========================================================================

# ---------------------------------------------------------------------------
# Stage 1: 构建前端资源
# ---------------------------------------------------------------------------
FROM node:20-slim AS builder

WORKDIR /build

COPY Desktop/package.json Desktop/package-lock.json* ./

RUN npm ci

COPY Desktop/ .

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:18789}

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: 生产运行时 (Nginx静态服务)
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS production

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /build/dist /usr/share/nginx/html

COPY Docker/config/nginx/desktop.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

STOPSIGNAL SIGQUIT

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
